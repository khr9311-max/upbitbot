# systemd 유닛 - EC2 재부팅 시 봇 컨테이너를 자동 기동한다.
#
#   sudo cp deploy/upbit-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now upbit-bot
#
# WorkingDirectory 는 실제 클론 경로에 맞게 수정할 것.

[Unit]
Description=Upbit AI Auto Trading Bot
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/upbit-bot
Environment=COMPOSE_PROJECT_NAME=upbitbot

ExecStartPre=-/usr/bin/docker compose -f deploy/docker-compose.yml down
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.yml up --build
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.yml down

# 봇이 죽어도 항상 되살린다. 단 재시작 폭주는 막는다.
Restart=always
RestartSec=20
StartLimitIntervalSec=300
StartLimitBurst=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=upbit-bot

[Install]
WantedBy=multi-user.target
