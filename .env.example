##############################################################################
# 업비트 AI 자동매매 봇 설정
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env
# 기본값 프로파일: 시드 30만원 미만 / 거래대금 상위 자동선정 / 공격형 리스크
##############################################################################

# ---------------------------------------------------------------------------
# 1. 인증  (https://upbit.com/mypage/open_api_management)
#    * API 키에는 "자산조회 + 주문" 권한만 부여하고 출금 권한은 반드시 비활성화
#    * 봇을 돌리는 서버의 고정 IP(EIP)만 화이트리스트에 등록
#    * 60~90일 주기로 키를 재발급할 것
# ---------------------------------------------------------------------------
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
UPBIT_ENVIRONMENT=kr

# ---------------------------------------------------------------------------
# 2. 실행 모드
#    DRY_RUN=True 면 실주문이 나가지 않고 모의계좌로만 동작한다.
#    전략서 권장: 실자본 투입 전 최소 2~4주 DRY_RUN 검증
# ---------------------------------------------------------------------------
DRY_RUN=True
DRY_RUN_SEED_KRW=300000
LOOP_INTERVAL_SEC=30

# ---------------------------------------------------------------------------
# 3. 매매 유니버스
#    auto  = KRW 마켓 전 종목에서 유의/주의 종목을 제외하고 거래대금 상위 N개 자동 선정
#    fixed = UNIVERSE_FIXED 에 적은 종목만 거래
# ---------------------------------------------------------------------------
UNIVERSE_MODE=auto
UNIVERSE_SIZE=3
UNIVERSE_FIXED=KRW-BTC,KRW-ETH,KRW-SOL
UNIVERSE_EXCLUDE=
# 24시간 거래대금 하한 (기본 300억원) - 잡코인 슬리피지 차단용. 낮출수록 위험
UNIVERSE_MIN_TRADE_PRICE_24H=30000000000
UNIVERSE_MAX_SPREAD_PCT=0.002
UNIVERSE_REFRESH_HOURS=6

# ---------------------------------------------------------------------------
# 4. 자본 배분 / 포지션
#    시드가 작을수록 동시 포지션을 줄여야 한다. (최소 주문금액 5,000원 제약)
#    30만원 미만 -> 2개, 100만원 이상 -> 3개, 300만원 이상 -> 4~5개 권장
# ---------------------------------------------------------------------------
MAX_CONCURRENT_POSITIONS=2
MAX_ASSET_ALLOC_PCT=0.5
MIN_ORDER_KRW=5000
CASH_RESERVE_PCT=0.05

# ---------------------------------------------------------------------------
# 5. 리스크 관리 (현재값: 공격형)
#    보수형 -> RISK_PER_TRADE_PCT=0.01 / KELLY_FRACTION=0.25
#              MAX_DRAWDOWN_PCT=0.10  / DAILY_LOSS_LIMIT_PCT=0.03
#    중립형 -> 0.015 / 0.30 / 0.20 / 0.05
# ---------------------------------------------------------------------------
RISK_PER_TRADE_PCT=0.02
KELLY_FRACTION=0.33
KELLY_MIN_TRADES=20
KELLY_LOOKBACK_TRADES=60
MAX_DRAWDOWN_PCT=0.30
DAILY_LOSS_LIMIT_PCT=0.08
CONSECUTIVE_LOSS_LIMIT=4
COOLDOWN_MINUTES=120

# ---------------------------------------------------------------------------
# 6. 1계층 - 시장 국면 분류 (HMM)
# ---------------------------------------------------------------------------
REGIME_USE_HMM=True
REGIME_TIMEFRAME=240
REGIME_CANDLES=600
REGIME_N_STATES=4
REGIME_REFIT_HOURS=24
REGIME_MIN_CONFIDENCE=0.55

# 국면별 자본 배분 비중 (전략서 2장 표)
ALLOC_STRONG_BULL=0.70
ALLOC_LOW_VOL_RANGE=0.80
ALLOC_VOLATILE_PULLBACK=0.45
ALLOC_STRONG_BEAR=0.0

# ---------------------------------------------------------------------------
# 7. 2계층 - 실행 파라미터
# ---------------------------------------------------------------------------
SIGNAL_TIMEFRAME=15
SIGNAL_CANDLES=200
FEE_RATE=0.0005
SLIPPAGE_PCT=0.0007

# 추세 국면: 변동성 돌파 + 샹들리에 출구
TREND_BREAKOUT_K=0.5
TREND_ADX_MIN=20
TREND_ADX_STRONG=30
TREND_RSI_MAX=80
TREND_CHANDELIER_N=22
TREND_CHANDELIER_K=3.0
TREND_CHANDELIER_K_STRONG=4.0
TREND_INIT_STOP_ATR=2.0
TREND_PARTIAL_TP_R=1.5
TREND_PARTIAL_TP_RATIO=0.4

# 횡보 국면: ATR 적응형 동적 그리드
GRID_LEVELS=3
GRID_ALPHA=1.0
GRID_ALPHA_MIN=0.6
GRID_ALPHA_MAX=2.0
GRID_MIN_SPACING_PCT=0.004
GRID_ORDER_TTL_MIN=180
GRID_BREAK_ATR=1.5

# 조정 국면: 한도 제어형 스마트 DCA
DCA_MAX_STEPS=3
DCA_STEP_ATR=1.0
DCA_SIZE_MULTIPLIERS=1.0,1.3,1.6
DCA_RSI_MAX=32
DCA_TP_PCT=0.03
DCA_SL_ATR=2.5
DCA_TIME_STOP_HOURS=48

# 하락 국면: 보유 포지션 강제 청산 여부
BEAR_FORCE_EXIT=True

# ---------------------------------------------------------------------------
# 8. 알림 / 운영
#    텔레그램: @BotFather 로 봇 생성 -> 토큰 발급, @userinfobot 으로 chat_id 확인
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEARTBEAT_MINUTES=240
LOG_LEVEL=INFO
STATE_FILE=data/state.json
KILL_SWITCH_FILE=data/STOP
LOG_DIR=logs
